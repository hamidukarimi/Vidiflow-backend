generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  name          String?

  emailVerified Boolean   @default(false)
  role          Role      @default(USER)

  provider      AuthProvider @default(LOCAL)
  providerId    String?

  refreshTokens RefreshToken[]
  downloads     Download[]
  favorites     Favorite[]  // add this line

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}


model Download {
  id           String   @id @default(cuid())
  videoUrl     String   @db.VarChar(500)
  provider     String   @db.VarChar(50)
  title        String?  @db.VarChar(500)
  thumbnail    String?  @db.Text

  status       DownloadStatus @default(PENDING)
  format       String?  @db.VarChar(20)
  quality      String?  @db.VarChar(20)
  
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  favorites    Favorite[]  // add this line

  errorMessage String?  @db.Text

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("downloads")
}

enum DownloadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}


model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  downloadId String
  download   Download @relation(fields: [downloadId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, downloadId])  // one favorite per user per download
  @@map("favorites")
}


