generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  name          String?

  emailVerified Boolean   @default(false)
  role          Role      @default(USER)

  provider      AuthProvider @default(LOCAL)
  providerId    String?

  refreshTokens RefreshToken[]
  downloads     Download[]  // add this line

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}


model Download {
  id           String   @id @default(cuid())
  videoUrl     String   @db.VarChar(500)
  provider     String   @db.VarChar(50)  // e.g., "youtube", "tiktok"
  title        String?  @db.VarChar(500)
  thumbnail    String?  @db.Text

  status       DownloadStatus @default(PENDING)  // pending, processing, completed, failed
  format       String?  @db.VarChar(20)  // e.g., "mp4", "mp3", "webm"
  quality      String?  @db.VarChar(20)  // e.g., "1080p", "720p", "128kbps"
  
  userId       String?  // nullable - guests can download
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  errorMessage String?  @db.Text  // if status = FAILED, store error details

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("downloads")
}

enum DownloadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}


