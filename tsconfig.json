{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": "./src",
    "paths": {
  "@modules/*": ["modules/*"],
  "@config/*": ["config/*"],
  "@database/*": ["database/*"],
  "@shared/*": ["shared/*"],
  "@middlewares/*": ["middlewares/*"],
  "@errors/*": ["errors/*"],
  "@responses/*": ["responses/*"]
}
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}